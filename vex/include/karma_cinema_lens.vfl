// ═══════════════════════════════════════════════════════════
// KARMA CVEX LENS SHADER — Cinema Camera Rig
//
// Contract: Houdini 21 "Creating a lens shader for Karma"
// (solaris/support/karma_lens_shader). Projection math mirrors the docs'
// "Standard projection" example so a zeroed shader matches Karma's
// built-in perspective camera exactly.
//
// Build:   vcc -O vop -l otls/cinema_lens_shader.hda \
//              -I vex/include vex/include/karma_cinema_lens.vfl
//          (builders/build_lens_shader_vop.py does this)
// Binding: camera prim attrs, authored by cinema_camera.karma_lens_shader:
//            karma:camera:use_lensshader = true
//            karma:camera:lensshader     = "opdef:/Vop/cinema_lens_shader?CVexVflCode <args>"
//
// Conventions:
//   - RHS camera space, rays look down -Z (negated when isRHS == 0).
//   - entrance_pupil_offset is in SCENE UNITS, positive toward the scene;
//     the binding code converts from mm using stage metersPerUnit.
//     (Sign source: cinema_camera.protocols.ENTRANCE_PUPIL_Z_SIGN.)
//   - Verified on Karma CPU; XPU lens-shader support unverified.
// ═══════════════════════════════════════════════════════════

#pragma opname  cinema_lens_shader
#pragma oplabel "Cinema Lens Shader"

#pragma label   effective_squeeze      "Effective Squeeze"
#pragma range   effective_squeeze      1.0 2.0
#pragma label   dist_sq_uniformity     "Squeeze Uniformity"
#pragma range   dist_sq_uniformity     0.8 1.0
#pragma label   entrance_pupil_offset  "Entrance Pupil Offset (scene units)"
#pragma label   dist_k1                "K1 (Radial)"
#pragma label   dist_k2                "K2 (Radial)"
#pragma label   dist_k3                "K3 (Radial)"
#pragma label   dist_p1                "P1 (Tangential)"
#pragma label   dist_p2                "P2 (Tangential)"
#pragma label   enable_distortion      "Enable Distortion"
#pragma hint    enable_distortion      toggle
#pragma label   enable_squeeze         "Enable Anamorphic Squeeze"
#pragma hint    enable_squeeze         toggle
#pragma label   enable_pupil_offset    "Enable Pupil Offset"
#pragma hint    enable_pupil_offset    toggle

#include <libcinema_optics.h>

cvex
cinema_lens_shader(
        // ── Karma-provided inputs (jittered NDC + DOF sampling) ──
        float x = 0;
        float y = 0;
        float Time = 0;
        float dofx = 0;
        float dofy = 0;
        float aspect = 1;
        float focus = 1;
        float focal = 1;
        float fstop = 0;
        float aperture = 1;
        int   isRHS = 0;

        // ── Outputs ──────────────────────────────────────────────
        export vector P = {0, 0, 0};
        export vector I = {0, 0, 0};
        export int valid = 1;

        // ── Cinema shader arguments (from the opdef binding) ─────
        float effective_squeeze = 1.0;
        float dist_sq_uniformity = 1.0;
        float entrance_pupil_offset = 0.0;
        float dist_k1 = 0.0;
        float dist_k2 = 0.0;
        float dist_k3 = 0.0;
        float dist_p1 = 0.0;
        float dist_p2 = 0.0;
        int   enable_distortion = 1;
        int   enable_squeeze = 1;
        int   enable_pupil_offset = 1;
)
{
    // ── Optical distortion + anamorphic squeeze in NDC ──────────
    vector2 uv = set(x, y);

    if (enable_distortion) {
        CO_DistortionCoeffs coeffs;
        coeffs.k1 = dist_k1;
        coeffs.k2 = dist_k2;
        coeffs.k3 = dist_k3;
        coeffs.p1 = dist_p1;
        coeffs.p2 = dist_p2;
        coeffs.squeeze_uniformity = dist_sq_uniformity;

        if (enable_squeeze && effective_squeeze > 1.01) {
            // Anamorphic: Brown-Conrady + focus-dependent squeeze (mumps)
            uv = co_apply_anamorphic_distortion(uv, coeffs, effective_squeeze);
        } else {
            // Spherical Brown-Conrady
            uv = co_apply_distortion(uv, coeffs);
        }
    } else if (enable_squeeze && effective_squeeze > 1.01) {
        // Squeeze only: the anamorphic front group widens horizontal FOV
        uv.x *= effective_squeeze;
    }

    // ── Standard projection (matches Karma's perspective camera) ─
    I = set(uv.x * aperture * 0.5 * aspect / focal,
            uv.y * aperture * 0.5 / focal,
            -1.0);              // RHS: look down -Z

    // ── Thin-lens origin: aperture-disk sample at the pupil ─────
    P = set(dofx, dofy, 0.0);
    if (enable_pupil_offset) {
        // Pupil sits toward the scene: negative Z in RHS camera space.
        P.z = -entrance_pupil_offset;
    }

    // Focus: every ray re-converges on the focus plane, so framing at
    // the focus plane is invariant and off-plane parallax is physical.
    I *= focus;
    I -= P;

    if (!isRHS) {
        P.z = -P.z;
        I.z = -I.z;
    }

    valid = 1;
}
