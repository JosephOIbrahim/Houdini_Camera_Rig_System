// ═══════════════════════════════════════════════════════════
// KARMA CVEX LENS SHADER — Cinema Camera Rig
//
// Contract: Houdini 21 "Creating a lens shader for Karma"
// (solaris/support/karma_lens_shader). Projection math mirrors the docs'
// "Standard projection" example so a zeroed shader matches Karma's
// built-in perspective camera exactly.
//
// Build:   vcc -O vop -l otls/cinema_lens_shader.hda \
//              -I vex/include vex/include/karma_cinema_lens.vfl
//          (builders/build_lens_shader_vop.py does this)
// Binding: camera prim attrs, authored by cinema_camera.karma_lens_shader:
//            karma:camera:use_lensshader = true
//            karma:camera:lensshader     = "opdef:/Vop/cinema_lens_shader?CVexVflCode <args>"
//
// Conventions:
//   - RHS camera space, rays look down -Z (negated when isRHS == 0).
//   - entrance_pupil_offset is in SCENE UNITS, positive toward the scene;
//     the binding code converts from mm using stage metersPerUnit.
//     (Sign source: cinema_camera.protocols.ENTRANCE_PUPIL_Z_SIGN.)
//   - Verified on Karma CPU; XPU lens-shader support unverified.
// ═══════════════════════════════════════════════════════════

#pragma opname  cinema_lens_shader
#pragma oplabel "Cinema Lens Shader"

#pragma label   effective_squeeze      "Effective Squeeze"
#pragma range   effective_squeeze      1.0 2.0
#pragma label   dist_sq_uniformity     "Squeeze Uniformity"
#pragma range   dist_sq_uniformity     0.8 1.0
#pragma label   entrance_pupil_offset  "Entrance Pupil Offset (scene units)"
#pragma label   dist_k1                "K1 (Radial)"
#pragma label   dist_k2                "K2 (Radial)"
#pragma label   dist_k3                "K3 (Radial)"
#pragma label   dist_p1                "P1 (Tangential)"
#pragma label   dist_p2                "P2 (Tangential)"
#pragma label   enable_distortion      "Enable Distortion"
#pragma hint    enable_distortion      toggle
#pragma label   enable_squeeze         "Enable Anamorphic Squeeze"
#pragma hint    enable_squeeze         toggle
#pragma label   enable_pupil_offset    "Enable Pupil Offset"
#pragma hint    enable_pupil_offset    toggle

#include <libcinema_optics.h>

cvex
cinema_lens_shader(
        // ── Karma-provided inputs (jittered NDC + DOF sampling) ──
        float x = 0;
        float y = 0;
        float Time = 0;
        float dofx = 0;
        float dofy = 0;
        float aspect = 1;
        float focus = 1;
        float focal = 1;
        float fstop = 0;
        float aperture = 1;
        int   isRHS = 0;

        // ── Outputs ──────────────────────────────────────────────
        export vector P = {0, 0, 0};
        export vector I = {0, 0, 0};
        export int valid = 1;
        export vector tint = {1, 1, 1};     // per-ray weight (apodization/vignette)

        // ── Cinema shader arguments (from the opdef binding) ─────
        float effective_squeeze = 1.0;
        float dist_sq_uniformity = 1.0;
        float entrance_pupil_offset = 0.0;
        float dist_k1 = 0.0;
        float dist_k2 = 0.0;
        float dist_k3 = 0.0;
        float dist_p1 = 0.0;
        float dist_p2 = 0.0;
        int   enable_distortion = 1;
        int   enable_squeeze = 1;
        int   enable_pupil_offset = 1;

        // ── Pupil / bokeh (Tier 2) ───────────────────────────────
        int   enable_bokeh = 0;
        int   iris_blades = 6;
        float iris_rotation_deg = 0.0;
        float blade_curvature = 0.0;        // 0 = straight polygon, 1 = round
        float apodization = 0.0;            // >0 creamy, <0 nervous (mean-1)
        int   enable_vignette = 0;
        float vignette_rv = 0.5;            // occlusion radius / focal
        float vignette_k = 0.2;             // occlusion offset per field / focal
        float image_circle = 10.0;          // hard field-radius cutoff (NDC; large = off)
)
{
    // ── Optical distortion (dn 3DE) + anamorphic squeeze (rpa) ──
    vector2 uv = set(x, y);

    // The ~2x anamorphic squeeze is a horizontal filmback rescale (rpa),
    // applied in the projection below -- NOT folded into the distortion (3DE
    // convention; the old radial+X-stretch conflated the two).
    float rpa = (enable_squeeze && effective_squeeze > 1.01) ? effective_squeeze : 1.0;

    if (enable_distortion) {
        // NDC (square [-1,1], aspect = image aspect -- empirically probed on
        // Houdini 21.0.765, scripts/probe_lens_ndc.py: max|x|~=max|y|~=1.0)
        // -> dn, r=1 at the frame corner. e = half-diagonal.
        float e = sqrt(aspect * aspect + 1.0);
        vector2 dn = set(uv.x * aspect / e, uv.y / e);

        if (enable_squeeze && effective_squeeze > 1.01) {
            // Anamorphic: per-axis cylindrical 3DE Anamorphic-Standard Deg-4,
            // which reproduces the horizontal/vertical asymmetry an isotropic
            // radial polynomial cannot. Seeded radial-equivalent from k1,k2
            // (cos2phi terms 0 until measured anamorphic coefficients exist);
            // the squeeze rides rpa, not this polynomial.
            CO_AnamorphicCoeffs ac;
            ac.cx02 = dist_k1; ac.cy02 = dist_k1;
            ac.cx04 = dist_k2; ac.cy04 = dist_k2;
            dn = co_anamorphic_undistort_g(dn, ac);
        } else {
            // Spherical: dn-normalized 3DE Radial-Standard (co_undistort_g maps
            // the distorted NDC sample -> the ideal rectilinear direction). At
            // zero coefficients this is the identity, so the projection still
            // matches Karma's perspective camera exactly.
            CO_DistortionCoeffs coeffs;
            coeffs.k1 = dist_k1;
            coeffs.k2 = dist_k2;
            coeffs.k3 = dist_k3;
            coeffs.p1 = dist_p1;
            coeffs.p2 = dist_p2;
            coeffs.squeeze_uniformity = dist_sq_uniformity;
            dn = co_undistort_g(dn, coeffs);
        }
        uv = set(dn.x * e / aspect, dn.y * e);
    }

    // ── Standard projection (matches Karma's perspective camera) ─
    // rpa widens the horizontal FOV for anamorphic capture.
    I = set(uv.x * aperture * 0.5 * aspect / focal * rpa,
            uv.y * aperture * 0.5 / focal,
            -1.0);              // RHS: look down -Z

    // ── Pupil sample: apodization + polygonal iris + mechanical vignette ─
    // Karma hands us a UNIFORM unit-disc sample (dofx,dofy). Reshape it into the
    // real iris and weight/clip it for spherical-aberration and cat's-eye bokeh.
    vector2 pupil = set(dofx, dofy);
    if (enable_bokeh) {
        // Spherical-aberration apodization on the ORIGINAL aperture fraction
        // (mean=1 over the disc, so in-focus points stay exposure-neutral).
        tint *= co_pupil_apodization(length(pupil), apodization);
        // Polygonal iris (blade count / rotation / curvature).
        pupil = co_pupil_polygon(pupil, iris_blades, iris_rotation_deg, blade_curvature);
    }
    if (enable_vignette) {
        // Field-dependent pupil clip -> cat's-eye + mechanical vignette darkening
        // + automatic stop-down recovery. Reject (valid=0), never renormalize.
        // Clip the RAW round stop disc (dofx,dofy), NOT the iris-reshaped pupil:
        // the vesica is the clean stop-disc INTERSECT occluder-disc (matches the
        // verified transmission); the iris polygon is a separate shape stage.
        if (co_pupil_catseye_valid(set(dofx, dofy), set(x, y), fstop, focal,
                                   vignette_rv, vignette_k, image_circle) == 0) {
            valid = 0;
        }
    }

    // ── Thin-lens origin at the (reshaped) pupil sample ─────────
    P = set(pupil.x, pupil.y, 0.0);
    if (enable_pupil_offset) {
        // Pupil sits toward the scene: negative Z in RHS camera space.
        P.z = -entrance_pupil_offset;
    }

    // Focus: every ray re-converges on the focus plane, so framing at
    // the focus plane is invariant and off-plane parallax is physical.
    I *= focus;
    I -= P;

    if (!isRHS) {
        P.z = -P.z;
        I.z = -I.z;
    }

    valid = 1;
}
