# Track only Cinema Camera Rig project files
# Ignore everything by default, then whitelist project paths
*

# Whitelist: Cinema Camera Rig project
!.gitignore
!cinema_camera/
!cinema_camera/**
!scripts/
!scripts/python/
!scripts/python/cinema_camera/
!scripts/python/cinema_camera/**
!vex/
!vex/include/
!vex/include/libcinema_optics.h
!vex/include/karma_cinema_lens.vfl
!otls/
!otls/cinema_*.hda
!packages/cinema_camera_rig.json
!packages/cinema_camera_rig.local.json.example
!scripts/install_package.ps1
!scripts/bootstrap_v3_build.py
!scripts/verify_v3.py
!scripts/probe_copernicus.py
!scripts/rebuild_and_verify.py
!.gitattributes
!README.md
!LICENSE

# Secrets: cinema_camera_rig.local.json holds WOLFRAM_APP_ID and other secrets;
# never commit it. The .example template above shows the schema.
packages/cinema_camera_rig.local.json

# Ignore backups and caches inside whitelisted dirs
**/backup/
__pycache__/
*.pyc
.pytest_cache/
